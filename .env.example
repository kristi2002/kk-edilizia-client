# =============================================================================
# K.K Edilizia — variabili d'ambiente
#
# Copia questo file in `.env.local` (ignorato da git) e compila i valori.
# In produzione: impostali nel pannello dell'hosting (Vercel → Settings → Environment
# Variables), non in un file committato.
#
# Le variabili `NEXT_PUBLIC_*` finiscono nel bundle del browser: sono pubbliche.
# Tutte le altre restano lato server. Non mettere segreti in `NEXT_PUBLIC_*`.
# =============================================================================


# --- Dominio pubblico -------------------------------------------------------
# Base per sitemap.xml, canonical, hreflang, Open Graph e `metadataBase`.
# Senza questa, il sito ripiega sul valore in `src/lib/site.ts`.
# Il campo `canonicalUrl` nel pannello admin, se valorizzato, ha la precedenza.
NEXT_PUBLIC_SITE_URL=https://kkedilizia.it

# Data (YYYY-MM-DD) usata come `lastmod` delle pagine statiche in sitemap.xml.
# Aggiornala quando pubblichi modifiche ai contenuti.
NEXT_PUBLIC_SITEMAP_STATIC_LASTMOD=


# --- Invio email dei moduli -------------------------------------------------
# Servono a /contatti, /preventivo e /prenota. Scegli UNA delle due strade.
#
# Strada A — Resend (consigliata in produzione)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Strada B — Gmail SMTP
# GMAIL_APP_PASSWORD è una "password per le app" di 16 caratteri, senza spazi:
# richiede la verifica in due passaggi attiva sull'account.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=

# Destinatari delle notifiche interne. Se vuoti, si usa l'indirizzo aziendale.
CONTATTI_NOTIFY_EMAIL=
PREVENTIVO_NOTIFY_EMAIL=
PRENOTA_NOTIFY_EMAIL=


# --- Pannello admin (/admin) ------------------------------------------------
# Senza ADMIN_PASSWORD e ADMIN_SESSION_SECRET l'intera area /admin risponde 404.
# ADMIN_SESSION_SECRET: stringa lunga e casuale, es. `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=


# --- Redis (Upstash) --------------------------------------------------------
# Copia runtime dei dati modificabili da /admin (azienda, portfolio, listini) e
# rate limiting dei moduli. Senza queste, il sito usa i valori statici in `src/lib/`
# e il rate limiting ricade su un contatore in memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Upload immagini (Vercel Blob) ------------------------------------------
# Serve solo all'upload di foto dal pannello admin.
BLOB_READ_WRITE_TOKEN=


# --- Analytics (opzionali) --------------------------------------------------
# Non caricano nulla finché il visitatore non accetta i cookie di statistica.
# Imposta GTM **oppure** GA4: se c'è NEXT_PUBLIC_GTM_ID, GA4 viene ignorato.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# --- WhatsApp (opzionale) ---------------------------------------------------
# Formato internazionale senza `+` e senza spazi, es. 393761201188.
# Se vuota, il pulsante flottante non viene mostrato.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# --- Feature flag -----------------------------------------------------------
# Portfolio (/portfolio, schede progetto, tour 360°): "true" per accendere.
# Con il flag spento le pagine sono noindex ed escluse dalla sitemap.
# Accendilo solo dopo aver sostituito i media dimostrativi con foto proprie.
NEXT_PUBLIC_ENABLE_PORTFOLIO=false

# Stima costi (/stima-costi): "true" per accendere.
NEXT_PUBLIC_ENABLE_COST_ESTIMATE=false


# --- Sentry (build) ---------------------------------------------------------
# Solo per l'upload delle source map in CI; il DSN è già nel codice.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# SENTRY_DEBUG_BUILD=1   # log dettagliati del plugin durante la build
